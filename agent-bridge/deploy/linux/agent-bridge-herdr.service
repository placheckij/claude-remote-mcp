# setup.sh installs this in ~/.config/systemd/user/ and fills in @HERDR_BIN@: herdr's
# server, headless, so agents can start after a reboot without anyone logging in. You can
# still attach to it with `herdr`. Stopping this unit stops every agent in herdr.
[Unit]
Description=herdr server for agent-bridge (claude-remote)

[Service]
ExecStart="@HERDR_BIN@" server
# Not after `herdr server stop`, which exits cleanly.
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
